# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notification_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV="development"

# Security
JWT_SECRET="super-secret-jwt-key-change-in-production"
SESSION_SECRET="super-secret-session-key-change-in-production"

# Authentication Providers (Placeholders)
OTP_PROVIDER_API_KEY="your-otp-provider-key"
OTP_PROVIDER_SECRET="your-otp-provider-secret"

# Appwrite Integration
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your-appwrite-project-id"
APPWRITE_API_KEY="your-appwrite-server-api-key"

# Push Notifications (Placeholders)
FCM_SERVER_KEY="your-fcm-server-key"
APNS_KEY_ID="your-apns-key-id"
APNS_TEAM_ID="your-apns-team-id"
APNS_BUNDLE_ID="your-apns-bundle-id"

# Admin Dashboard
ADMIN_AUTH_SECRET="admin-secret-change-in-production"
